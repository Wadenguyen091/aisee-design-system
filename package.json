{
  "name": "@aisee/design-system",
  "version": "0.1.1",
  "description": "Base design knowledge, tokens and React components for AISEE and its Mini Apps.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "src",
    "docs",
    "AISEE_DESIGN_KNOWLEDGE.md",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./theme.css": "./src/theme.css",
    "./tokens.css": "./src/tokens.css",
    "./manifest": "./src/manifest.ts",
    "./component-governance": "./src/componentGovernance.ts",
    "./component-intake.json": "./src/component-intake.manifest.json",
    "./assets": "./src/assets.ts",
    "./icons": "./src/icons.tsx",
    "./theme": "./src/theme.ts",
    "./base/colorMath": "./src/base/colorMath.ts",
    "./base/useDialogBehavior": "./src/base/useDialogBehavior.ts",
    "./base/*.css": "./src/base/*.css",
    "./base/*": "./src/base/*.tsx",
    "./application/aiChatEngine": "./src/application/aiChatEngine.ts",
    "./application/*.css": "./src/application/*.css",
    "./application/*": "./src/application/*.tsx"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "npm run check"
  },
  "peerDependencies": {
    "@remixicon/react": "^4.9.0",
    "lucide-react": "^1.61.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@remixicon/react": "^4.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "lucide-react": "^1.61.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^7.0.2"
  }
}
